# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_PROTOCOL=bolt

# Google APIs
GOOGLE_KEY=your_google_api_key_here

# SQLite
DB_PATH=/data/smarthub.sqlite

# Auth
SESSION_COOKIE_NAME=smarthub_session
SESSION_MAX_AGE_DAYS=3650
COOKIE_SECURE=false

# Google OAuth (Calendar Connect)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3001

# Frontend
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional Docker port overrides
BACKEND_PORT=3000
FRONTEND_PORT=3001

# CORS — comma-separated list of additional allowed origins (e.g. for LAN devices)
# Example: ALLOWED_ORIGINS=http://192.168.1.50:3001,https://myhub.local
ALLOWED_ORIGINS=

# KNX Multicast Configuration
KNX_ENABLED=true
KNX_MULTICAST_IP=224.0.23.12
KNX_PORT=3671
KNX_PHYS_ADDR=1.2.6
KNX_INTERFACE=
